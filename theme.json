{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "primary", "color": "#2f6bff", "name": "Primary" },
				{ "slug": "primary-dark", "color": "#1e4fd6", "name": "Primary Dark" },
				{ "slug": "accent", "color": "#ff4d6d", "name": "Accent" },
				{ "slug": "ink", "color": "#14161c", "name": "Ink" },
				{ "slug": "body", "color": "#2b2f3a", "name": "Body Text" },
				{ "slug": "muted", "color": "#6b7280", "name": "Muted" },
				{ "slug": "line", "color": "#e6e8ee", "name": "Line" },
				{ "slug": "surface", "color": "#f6f7f9", "name": "Surface" },
				{ "slug": "base", "color": "#ffffff", "name": "Base" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeightControl": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "vazirmatn",
					"name": "Vazirmatn",
					"fontFamily": "Vazirmatn, Tahoma, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "Tahoma, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "کوچک" },
				{ "slug": "medium", "size": "1.05rem", "name": "متوسط" },
				{ "slug": "large", "size": "1.375rem", "name": "بزرگ" },
				{ "slug": "x-large", "size": "1.85rem", "name": "خیلی بزرگ" },
				{ "slug": "xx-large", "size": "clamp(2.2rem, 1.6rem + 2.5vw, 3.2rem)", "name": "تیتر" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vw", "%"],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "۱" },
				{ "slug": "30", "size": "1rem", "name": "۲" },
				{ "slug": "40", "size": "1.5rem", "name": "۳" },
				{ "slug": "50", "size": "2.5rem", "name": "۴" },
				{ "slug": "60", "size": "4rem", "name": "۵" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--vazirmatn)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.85"
		},
		"elements": {
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.45" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } }
			}
		}
	}
}
